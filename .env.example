# --- LLM (set at least one for real answers; otherwise offline demo mode) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic   # anthropic | openai | mock

# --- Embeddings: hash (offline, default) | st (sentence-transformers) | openai ---
EMBEDDER=hash

# --- Security ---
# JWT_SECRET=change-me   (auto-generated into backend/data/.jwt_secret if empty)
